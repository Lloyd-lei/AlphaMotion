                    "name": "ForwardArchi",
                    "hidden_dim": 2048,
                    "model": "residual",
                    "hidden_layers": 6,
                    "embedding_layers": 2,
                    "num_parallel": 2,
                    "ensemble_mode": "batch",
                    "input_filter": {
                        "name": "DictInputFilterConfig",
                        "key": [
                            "state",
                            "privileged_state",
                            "last_action",
                            "history_actor"
                        ]
                    }
                },
                "b": {
                    "name": "BackwardArchi",
                    "hidden_dim": 256,
                    "hidden_layers": 1,
                    "norm": true,
                    "input_filter": {
                        "name": "DictInputFilterConfig",
                        "key": [
                            "state",
                            "privileged_state"
                        ]
                    }
                },
                "actor": {
                    "name": "actor",
                    "model": "residual",
                    "hidden_dim": 2048,
                    "hidden_layers": 6,
                    "embedding_layers": 2,
                    "input_filter": {
                        "name": "DictInputFilterConfig",
                        "key": [
                            "state",
                            "last_action",
                            "history_actor"
                        ]
                    }
                },
                "critic": {
                    "name": "ForwardArchi",
                    "hidden_dim": 2048,
                    "model": "residual",
                    "hidden_layers": 6,
                    "embedding_layers": 2,
                    "num_parallel": 2,
                    "ensemble_mode": "batch",
                    "input_filter": {
                        "name": "DictInputFilterConfig",
                        "key": [
                            "state",
                            "privileged_state",
                            "last_action",
                            "history_actor"
